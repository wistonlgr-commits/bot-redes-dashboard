              "fieldValue": "=={{\n  (() => {\n    const data = $('Recibir WhatsApp').item.json.body.data;\n    \n    // 1. Extraemos el link del anuncio (ya sea por el método nuevo de Evolution o el tradicional)\n    const linkAnuncio = data.contextInfo?.externalAdReply?.mediaUrl || data.message?.extendedTextMessage?.contextInfo?.sourceUrl || '';\n    \n    // 2. Evaluamos si es Instagram\n    if (linkAnuncio.includes('instagram.com')) {\n      return 'Instagram Ads';\n    } \n    // 3. Evaluamos si es Facebook\n    else if (linkAnuncio.includes('facebook.com') || linkAnuncio.includes('fb.me') || data.contextInfo?.conversionSource === 'FB_Ads') {\n      return 'Facebook Ads';\n    }\n    \n    // 4. Si no tiene nada de lo anterior, es Orgánico\n    return 'Organico';\n  })()\n}}"
