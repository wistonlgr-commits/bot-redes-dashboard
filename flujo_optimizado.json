    {
      "parameters": {
        "jsCode": "// Busca texto recursivamente en cualquier estructura JSON\nfunction findText(obj, depth) {\n  if (depth > 5) return \"\";\n  if (typeof obj === 'string' && obj.length > 20) return obj;\n  if (Array.isArray(obj)) {\n    for (const item of obj) {\n      const found = findText(item, depth + 1);\n      if (found) return found;\n    }\n  }\n  if (typeof obj === 'object' && obj !== null) {\n    for (const val of Object.values(obj)) {\n      const found = findText(val, depth + 1);\n      if (found) return found;\n    }\n  }\n  return \"\";\n}\n\n// Lista de frases que NUNCA deben llegar al paciente\nconst ERROR_PATTERNS = [\n  'service unavailable',\n  'status code 503',\n  'status code 500',\n  'status code 429',\n  'internal server error',\n  'NodeOperationError',\n  'ECONNREFUSED',\n  'ETIMEDOUT',\n  'socket hang up'\n];\n\nfunction isErrorMessage(text) {\n  if (!text) return true;\n  const lower = text.toLowerCase();\n  return ERROR_PATTERNS.some(p => lower.includes(p.toLowerCase()));\n}\n\nconst FALLBACK_MSG = \"Hola! Disculpa, estoy teniendo un inconveniente tecnico en este momento. Por favor escribeme de nuevo en unos minutos y te atiendo con gusto.\";\n\nlet history = $node[\"Refrescar Datos de Supabase\"].json.chat_history || [];\nlet fullResponse = \"\";\n\n// Intentar extraer la respuesta de Gemini\ntry {\n  fullResponse = findText($json, 0);\n} catch (e) {\n  fullResponse = \"\";\n}\n\n// NUEVA LÓGICA: Si contiene |||DATOS|||, es una respuesta VÁLIDA de Gemini\nlet gemini_failed = false;\nif (!fullResponse || fullResponse.length < 5) {\n  fullResponse = FALLBACK_MSG;\n  gemini_failed = true;\n} else if (fullResponse.includes('|||DATOS|||')) {\n  gemini_failed = false;\n} else if (isErrorMessage(fullResponse)) {\n  fullResponse = FALLBACK_MSG;\n  gemini_failed = true;\n}\n\nfullResponse = fullResponse.replace(/\\\\n/g, ' ').replace(/\\n/g, ' ').replace(/  +/g, ' ').trim();\n\n// Segundo chequeo despues de limpiar (ignorando si hay datos)\nif (!fullResponse.includes('|||DATOS|||') && isErrorMessage(fullResponse)) {\n  fullResponse = FALLBACK_MSG;\n  gemini_failed = true;\n}\n\nlet botMsg = fullResponse;\nlet datosExtraidos = {\n  nombre: undefined, ciudad: undefined, motivo_consulta: undefined, temperatura: undefined, resumen: undefined, dia_cita: undefined, hora_cita: undefined, requiere_asistencia_humana: undefined\n};\n\nif (!gemini_failed && fullResponse.includes('|||DATOS|||')) {\n  const partes = fullResponse.split('|||DATOS|||');\n  botMsg = partes[0].trim();\n  \n  try {\n    const jsonStr = partes[1].trim();\n    const datos = JSON.parse(jsonStr);\n    if ('nombre' in datos) datosExtraidos.nombre = datos.nombre || \"\";\n    if ('ciudad' in datos) datosExtraidos.ciudad = datos.ciudad || \"\";\n    if ('motivo_consulta' in datos) datosExtraidos.motivo_consulta = datos.motivo_consulta || \"\";\n    if ('temperatura' in datos) datosExtraidos.temperatura = datos.temperatura || \"\";\n    if ('resumen' in datos) datosExtraidos.resumen = datos.resumen || \"\";\n    if ('dia_cita' in datos) datosExtraidos.dia_cita = typeof datos.dia_cita === 'string' ? datos.dia_cita : \"\";\n    if ('hora_cita' in datos) datosExtraidos.hora_cita = typeof datos.hora_cita === 'string' ? datos.hora_cita : \"\";\n    if ('requiere_asistencia_humana' in datos) datosExtraidos.requiere_asistencia_humana = datos.requiere_asistencia_humana || \"\";\n  } catch (e) {\n    try {\n      const textoJson = partes[1].trim();\n      const matchDia = textoJson.match(/\"dia_cita\"\\s*:\\s*\"([^\"]*)\"/);\n      const matchHora = textoJson.match(/\"hora_cita\"\\s*:\\s*\"([^\"]*)\"/);\n      const matchAlerta = textoJson.match(/\"requiere_asistencia_humana\"\\s*:\\s*\"([^\"]*)\"/);\n      if (matchDia) datosExtraidos.dia_cita = matchDia[1];\n      if (matchHora) datosExtraidos.hora_cita = matchHora[1];\n      if (matchAlerta) datosExtraidos.requiere_asistencia_humana = matchAlerta[1];\n    } catch (e2) {}\n  }\n}\n\nconst prevData = $node[\"Refrescar Datos de Supabase\"].json || {};\nconst nombre_final = datosExtraidos.nombre !== undefined ? datosExtraidos.nombre : (prevData.Nombre || \"\");\nconst ciudad_final = datosExtraidos.ciudad !== undefined ? datosExtraidos.ciudad : (prevData.Ciudad || \"\");\nconst motivo_final = datosExtraidos.motivo_consulta !== undefined ? datosExtraidos.motivo_consulta : (prevData.Motivo_Consulta || \"\");\nconst temp_final = datosExtraidos.temperatura !== undefined ? datosExtraidos.temperatura : (prevData.Temperatura || \"\");\nconst resumen_final = datosExtraidos.resumen !== undefined ? datosExtraidos.resumen : (prevData.Resumen || \"\");\n\nconst dia_final = datosExtraidos.dia_cita !== undefined ? datosExtraidos.dia_cita : (prevData.Dia_Cita || \"\");\nconst hora_final = datosExtraidos.hora_cita !== undefined ? datosExtraidos.hora_cita : (prevData.Hora_Cita || \"\");\nconst alerta_final = datosExtraidos.requiere_asistencia_humana !== undefined ? datosExtraidos.requiere_asistencia_humana : (prevData.requiere_asistencia_humana || \"\");\n\n// Solo agregar al historial si Gemini respondio de verdad\nif (!gemini_failed) {\n  history.push({ role: \"assistant\", content: botMsg });\n}\nif (history.length > 8) history = history.slice(history.length - 8);\n\nlet random_delay = Math.floor(Math.random() * (8000 - 3000 + 1)) + 3000;\n\nreturn {\n  final_history: history,\n  bot_reply: botMsg,\n  delay: random_delay,\n  nombre: nombre_final,\n  ciudad: ciudad_final,\n  motivo_consulta: motivo_final,\n  temperatura: temp_final,\n  resumen: resumen_final,\n  dia_cita: dia_final,\n  hora_cita: hora_final,\n  requiere_asistencia_humana: alerta_final\n};"
      },
