        "jsCode": "let occupied = [];\nconst todayStr = new Date(new Date().toLocaleString(\"en-US\", {timeZone: \"America/Caracas\"})).toISOString().split('T')[0];\nfor (const lead of $input.all()) {\n  const date = lead.json.Dia_Cita;\n  const time = lead.json.Hora_Cita || 'Hora no especificada';\n  const nombre = lead.json.Nombre || '';\n  if (date && date >= todayStr && date !== '') {\n    if (nombre.includes('[BLOQUEO]') || time === 'TODO EL DIA' || time === 'TODA LA SEMANA') {\n      occupied.push('- ' + date + ' -> BLOQUEADO ' + time + ' (NO AGENDAR)');\n    } else {\n      occupied.push('- ' + date + ' a las ' + time);\n    }\n  }\n}\nlet txt = occupied.length > 0 ? occupied.join('\\n') : 'Agenda libre';\nreturn { agenda_ocupada: txt };"
      },
